{
  "cleanupPeriodDays": 90,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__openmemory__add_memories",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm start)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git log:*)",
      "mcp__notion__notion-fetch",
      "Bash(mkdir:*)",
      "WebFetch(domain:developers.kit.com)",
      "Bash(uv run python:*)",
      "Bash(python:*)",
      "Bash(uv add:*)",
      "WebFetch(domain:github.com)",
      "Bash(/home/tocanoctavian/.local/bin/uv run python:*)",
      "mcp__Fireflies__get_transcript",
      "mcp__notionApi__API-post-search"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["notion", "Fireflies", "context7"],
  "disabledMcpjsonServers": ["web-scraper", "system-admin", "network-tools"],
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/scripts/context-monitor.py"
  },
  "outputStyle": "default"
}
